# =========================
# BACKEND (Python / FastAPI)
# =========================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual Environments
venv/
env/
.venv/
.env_workspace/

# Python Tools
.pytest_cache/
.coverage
htmlcov/

# =========================
# FRONTEND (Next.js / Node)
# =========================
# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js Build output
.next/
out/
build/

# Vercel/Next.js environment variables (Ignore the real ones!)
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.example

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =========================
# OS & GENERAL (Global)
# =========================
# Environment Variables (Keep .env hidden, but let .env.example track)
.env
*.env

# Mac / Windows system files
.DS_Store
Thumbs.db

# IDEs and Editors
.vscode/
.idea/
*.swp